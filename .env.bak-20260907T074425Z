# openGym — instancia de Alberto (VPS OVH, nginx + Certbot manual)
# Convención del host: el contenedor web se publica SOLO en loopback y nginx
# del host termina TLS y hace proxy_pass a 127.0.0.1:8090.
# 8080 (el default de openGym) ya lo ocupa ktor-huertando — no se toca.

RP_ID=gym.albertoalbaladejo.com
ORIGIN=https://gym.albertoalbaladejo.com
WEB_PORT=127.0.0.1:8090
RP_NAME=openGym

# Nginx del host ya pone X-Forwarded-For/X-Real-IP reales; el contenedor web los
# reescribe otra vez con su propio peer. Sin Cloudflare delante -> sin CF_CONNECTING_IP.
AUDIT_IP=net

