  "daily_postural_routine": [
    {
      "name": "Chin tucks",
      "sets": 3,
      "reps": "10",
      "note": "retracción de barbilla, aguantar 5s",
      "progression": "off",
      "description": "Sentado o de pie, espalda recta y mirada al frente. Lleva la barbilla hacia atrás como si hicieras papada, sin bajar la cabeza ni mirar al suelo. Aguanta 5 s notando estiramiento en la nuca y suelta despacio. Control: las orejas deben quedar alineadas sobre los hombros, no por delante."
    },
    {
      "name": "Estiramiento de pectoral en marco de puerta",
      "sets": 3,
      "timed_s": "30-45",
      "note": "por lado",
      "progression": "off",
      "description": "De pie en el marco de una puerta. Apoya antebrazo y palma en el marco con el codo a 90° y a la altura del hombro. Da un paso corto adelante con la pierna del mismo lado hasta notar estiramiento en el pecho. Aguanta 30-45 s sin rebotes y cambia de lado. Control: hombro abajo y atrás, sin arquear la zona lumbar."
    },
    {
      "name": "Wall angels",
      "sets": 3,
      "reps": "10",
      "progression": "off",
      "description": "De espaldas a la pared, pies a un palmo de ella. Pega glúteos, espalda alta y cabeza a la pared. Brazos en cruz con codos a 90°, dorso de manos y codos tocando la pared. Sube los brazos como un ángel de nieve y baja despacio. Control: si la zona lumbar o las muñecas se despegan, has subido demasiado — para ahí."
    }
